# Copia este archivo a .env y cambia los valores antes de levantar el stack.
#   cp .env.example .env

# PostgreSQL
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=cambia_esta_password

# Keycloak - usuario administrador inicial
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambia_esta_password

# Flask webapp
FLASK_SECRET_KEY=genera_una_clave_aleatoria
OIDC_CLIENT_ID=flask-app
# Debe coincidir con el "secret" del cliente en realm/demo-realm.json
OIDC_CLIENT_SECRET=flask-app-secret
